<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sales_route_form" model="ir.ui.view">
        <field name="name">sales.route.form</field>
        <field name="model">sales.route</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="date"/>
                    </group>
                    <notebook>
                        <page string="Visits">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="status"/>
                                    <field name="visit_time"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sales_route_tree" model="ir.ui.view">
        <field name="name">sales.route.list</field>
        <field name="model">sales.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_sales_route" model="ir.actions.act_window">
        <field name="name">Sales Routes</field>
        <field name="res_model">sales.route</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sales_route_root" name="Routes" parent="sale.sale_menu_root" sequence="10"/>
    <menuitem id="menu_sales_route" name="My Routes" parent="menu_sales_route_root" action="action_sales_route"/>
</odoo>
